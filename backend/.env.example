# Copy to backend/.env and adjust. Never commit .env.

# --- Google OAuth -----------------------------------------------------------
# Desktop OAuth client JSON downloaded from Google Cloud Console.
GOOGLE_CLIENT_SECRET_FILE=credentials/client_secret.json
# Base URL of this backend; OAuth redirects to <PUBLIC_BASE_URL>/api/auth/callback
PUBLIC_BASE_URL=http://localhost:8000
# Where the browser lands after connecting (the dashboard). Use http://localhost:5173 when running `npm run dev`.
DASHBOARD_URL=http://localhost:8000
# Also request youtube.force-ssl so already-uploaded scheduled videos can be rescheduled from the dashboard.
YOUTUBE_ENABLE_MANAGE_SCOPE=false

# --- AI metadata (Claude) ---------------------------------------------------
# Without a key, a simple template is used instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
METADATA_AI_ENABLED=true

# --- Server / security ------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Required if HOST is not localhost. Dashboard asks for it; API accepts "Authorization: Bearer <token>".
DASHBOARD_TOKEN=
# Enables /api/agent/* for an orchestrator (Claude Code, scripts...). Leave empty to disable.
AGENT_API_TOKEN=
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173

# --- Storage ----------------------------------------------------------------
DATA_DIR=data
CREDENTIALS_DIR=credentials
# Where the clipping engine drops finished clips (defaults to <DATA_DIR>/incoming)
# INCOMING_DIR=D:/clipper/output
# LIBRARY_DIR=data/library
# DATABASE_URL=sqlite:///data/app.db

# --- Tools / tuning ---------------------------------------------------------
FFPROBE_PATH=ffprobe
UPLOAD_CHUNK_SIZE_MB=8
UPLOAD_MAX_RETRIES=8
INGEST_INTERVAL_SECONDS=30
SCHEDULER_ENABLED=true

# --- AI Clipper (OpenAI) ------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5                    # finds moments, writes hooks; also writes metadata if no ANTHROPIC_API_KEY
OPENAI_TRANSCRIBE_MODEL=whisper-1       # needs word timestamps for captions
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=ash                    # alloy ash ballad coral echo fable nova onyx sage shimmer verse
# OPENAI_TTS_INSTRUCTIONS=Energetic, friendly gaming YouTuber...
AVATAR_PATH=assets/avatar.png           # square PNG with transparent background
AVATAR_MOUTH=292,274                    # mouth position in the 600x600 avatar (for the talking animation)
AVATAR_MOUTH_ENABLED=true
CLIP_SLOWMO=true                        # slow motion on the strongest real impact (once per clip)
VIDEO_ENCODER=auto                      # auto (Intel Quick Sync, falls back to libx264) | libx264 | h264_qsv

# ---- AI Information Video Studio
# Stock footage/photos: either key is enough (both free). Pexels has paused new keys; Pixabay: sign up at pixabay.com,
# then the key is shown on https://pixabay.com/api/docs/
PIXABAY_API_KEY=
PEXELS_API_KEY=
# Background music (optional): free client ID from https://devportal.jamendo.com (only CC BY / CC BY-SA tracks are used).
# Or put your own tracks in backend/data/music/<mood>/  (energetic, upbeat, epic, suspense, mysterious, dark, emotional, chill)
JAMENDO_CLIENT_ID=
# Models (optional overrides)
STUDIO_RESEARCH_MODEL=gpt-5.5
STUDIO_SCRIPT_MODEL=gpt-5.5
STUDIO_STORYBOARD_MODEL=gpt-5.5
STUDIO_QA_MODEL=gpt-5.5
STUDIO_IMAGE_MODEL=gpt-image-1.5
STUDIO_IMAGE_QUALITY=medium             # low | medium | high (cost per AI image)
